# Set explicitly in the shell; neither HTTP startup nor migrations auto-load this file.
DATABASE_URL=
# Disposable local DB named stockapp_test, with permission to create/drop test databases.
# Never falls back to DATABASE_URL. No remote hosts or URL query options.
TEST_DATABASE_URL=
# AUTH_BASE_URL enables auth composition; without it, start runs foundation-only.
# Explicit absolute origin, no path/query/wildcard. HTTPS required in production.
AUTH_BASE_URL=
APP_ORIGIN=
# Off by default. true is accepted only in Railway environment uat with the exact
# StockApp staging APP_ORIGIN/AUTH_BASE_URL. New verified owners get access at bootstrap.
# Does not enable existing/disabled businesses or bypass verification/ownership/deletion.
UAT_AUTO_ENABLE_CLOUD_ACCESS=false
# At least 32 characters. No default; generate and store privately before deploying.
BETTER_AUTH_SECRET=
# Dedicated stable key, at least 32 characters; retain across restores independently of auth rotation.
DELETION_SUPPRESSION_SECRET=
# Defaults to smtp. Use resend explicitly for HTTPS delivery on Railway Hobby.
AUTH_EMAIL_TRANSPORT=smtp
# Resend only: a verified bare sender address and a privately provisioned sending key.
AUTH_EMAIL_FROM=
RESEND_API_KEY=
# SMTP variables are required only when AUTH_EMAIL_TRANSPORT=smtp (or unset).
SMTP_HOST=
SMTP_PORT=
# tls (implicit TLS), starttls (required upgrade), local (loopback, non-production only).
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# Single bare sender email address.
SMTP_FROM=
