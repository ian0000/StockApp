{
  "name": "@stock-app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "generate:client": "pnpm --filter @stock-app/contracts exec tsx src/browser-error-cli.ts ../../apps/web/src/api/generated",
    "dev": "pnpm generate:client && vite",
    "build": "pnpm generate:client && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "pnpm generate:client && eslint src test vite.config.ts --max-warnings=0",
    "typecheck": "pnpm generate:client && tsc --noEmit",
    "test": "pnpm generate:client && tsx --conditions=development --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@stock-app/application": "workspace:*",
    "@stock-app/contracts": "workspace:*",
    "@stock-app/domain": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "better-auth": "1.7.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.18.4",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7"
  }
}
