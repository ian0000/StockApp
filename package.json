{
  "name": "stock-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm ci:lint && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm ci:test && pnpm -r test",
    "ci:test": "node --test scripts/ci/*.test.mjs",
    "ci:lint": "eslint scripts/ci --max-warnings=0",
    "ci:classify": "node scripts/ci/classify.mjs",
    "ci:run": "node scripts/ci/run.mjs",
    "ci:docs": "node scripts/ci/docs.mjs",
    "ci:validators": "node scripts/ci/validators.mjs",
    "ci:workflows": "node scripts/ci/workflow-lint.mjs",
    "build:api": "pnpm --filter @stock-app/api build",
    "build:web": "pnpm --filter @stock-app/web build",
    "test:db": "pnpm --filter @stock-app/api test:db",
    "contracts:openapi": "tsx packages/contracts/src/openapi-cli.ts",
    "contracts:openapi:check": "tsx packages/contracts/src/openapi-cli.ts --check",
    "check": "pnpm contracts:openapi:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:api && pnpm build:web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.2"
  }
}
